FROM nvidia/cuda:12.9.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

USER root

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        apt-transport-https \
        bash-completion \
        build-essential \
        ca-certificates \
        ccache \
        curl \
        fd-find \
        fzf \
        g++ \
        gcc \
        gdb \
        gfortran \
        git \
        git-lfs \
        gnupg \
        jq \
        less \
        libhdf5-dev \
        libopenmpi-dev \
        lldb \
        nano \
        ninja-build \
        nodejs \
        npm \
        openmpi-bin \
        openssh-client \
        pre-commit \
        python3-dev \
        python3-h5py \
        python3-matplotlib \
        python3-numpy \
        python3-pip \
        python3-venv \
        ripgrep \
        shellcheck \
        sudo \
        tmux \
        unzip \
        vim \
        wget \
        zip && \
    rm -rf /var/lib/apt/lists/*

# Install Clang 20 and clangd.
RUN mkdir -m 0755 -p /etc/apt/keyrings && \
    curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor -o /etc/apt/keyrings/llvm-snapshot.gpg.key && \
    echo "deb [signed-by=/etc/apt/keyrings/llvm-snapshot.gpg.key] http://apt.llvm.org/noble/ llvm-toolchain-noble-20 main" > /etc/apt/sources.list.d/llvm.list && \
    apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends clang-20 llvm-20 libomp-20-dev libclang-rt-20-dev clangd-20 && \
    ln -sf /usr/bin/clangd-20 /usr/bin/clangd && \
    rm -rf /var/lib/apt/lists/*

# Install current CMake from Kitware.
RUN mkdir -m 0755 -p /etc/apt/keyrings && \
    curl -fsSL https://apt.kitware.com/keys/kitware-archive-latest.asc | gpg --dearmor -o /usr/share/keyrings/kitware-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ noble main" > /etc/apt/sources.list.d/kitware.list && \
    apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends cmake && \
    rm -rf /var/lib/apt/lists/*

# Install the GitHub CLI from GitHub's apt repository.
RUN mkdir -p -m 0755 /etc/apt/keyrings && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends gh && \
    rm -rf /var/lib/apt/lists/*

RUN git lfs install --system && \
    ln -sf /usr/bin/fdfind /usr/local/bin/fd && \
    id -u ubuntu >/dev/null 2>&1 || useradd -m -s /bin/bash ubuntu && \
    usermod -aG sudo ubuntu && \
    echo "ubuntu ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ubuntu && \
    chmod 0440 /etc/sudoers.d/ubuntu

USER ubuntu
WORKDIR /home/ubuntu

RUN curl -fsSL https://claude.ai/install.sh | bash

ENV PATH="/home/ubuntu/.local/bin:/home/ubuntu/.claude/local:${PATH}" \
    PIP_BREAK_SYSTEM_PACKAGES=1

CMD [ "/bin/bash" ]
