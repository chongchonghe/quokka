# Full build from the published ROCm base image.  Equivalent to the companion
# Dockerfile but adds a chmod step so any host UID (not just 'agent') can use
# the installed tools when running under Singularity.
#
# Requires root or fakeroot — building with %post always does.
#
# Build (run from the directory where you want quokka-rocm-claude.sif):
#   singularity build --fakeroot quokka-rocm-claude.sif /path/to/quokka-rocm-claude.def
#   # or, if fakeroot is not configured:
#   sudo singularity build quokka-rocm-claude.sif /path/to/quokka-rocm-claude.def
Bootstrap: docker
From: ghcr.io/quokka-astro/quokka-linux-amd64-rocm:development

%post
    # Install baseline tools for interactive agentic coding, debugging, and PR workflows.
    zypper --non-interactive refresh
    zypper --non-interactive update
    zypper --non-interactive remove busybox-less || true
    zypper --non-interactive install \
        bash-completion \
        ca-certificates \
        ccache \
        curl \
        fd \
        fzf \
        gdb \
        git \
        git-lfs \
        gpg2 \
        jq \
        less \
        libicu-devel \
        lldb \
        nano \
        ninja \
        nodejs20 \
        npm20 \
        openssh \
        python311 \
        python311-pip \
        python311-devel \
        python311-setuptools \
        python311-wheel \
        ripgrep \
        ShellCheck \
        sudo \
        tar \
        gzip \
        tmux \
        unzip \
        vim \
        wget \
        which \
        zip
    zypper clean --all

    # Set Python 3.11 as the default python3
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1
    update-alternatives --install /usr/bin/pip3 pip3 /usr/bin/pip3.11 1

    # Install Python packages
    python3 -m pip install --upgrade pip
    python3 -m pip install h5py cached-property numpy matplotlib pre-commit

    # Install Azure CLI
    rpm --import https://packages.microsoft.com/keys/microsoft.asc
    zypper --non-interactive addrepo \
        --name 'Azure CLI' \
        --check https://packages.microsoft.com/yumrepos/azure-cli \
        azure-cli
    zypper --non-interactive install azure-cli
    zypper clean --all

    # Install GitHub CLI
    GH_VERSION=$(curl -fsSL https://api.github.com/repos/cli/cli/releases/latest \
        | jq -r '.tag_name' | sed 's/^v//')
    curl -fsSLo /tmp/gh.rpm \
        "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.rpm"
    rpm -ivh /tmp/gh.rpm
    rm /tmp/gh.rpm

    # git-lfs, fd alias, codex
    git lfs install --system
    ln -sf /usr/bin/fd /usr/local/bin/fd
    npm install -g @openai/codex

    # Create agent user with sudo access (mirrors Docker image layout)
    mkdir -p /azp
    groupadd agent
    useradd -m -d /home/agent -s /bin/bash -g agent agent
    usermod -a -G users agent
    echo "agent ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/agent
    chmod 0440 /etc/sudoers.d/agent
    chown -R agent:agent /azp /home/agent

    # Install Claude CLI as agent user (same as Docker), then fix permissions so
    # any host UID can access the files when Singularity runs.
    su - agent -c 'curl -fsSL https://claude.ai/install.sh | bash'
    chmod -R a+rX /home/agent/.local /home/agent/.claude 2>/dev/null || true

    # Profile.d snippet runs last (zzz- prefix) so PATH survives anything that
    # resets it in /etc/bash.bashrc or earlier profile.d scripts.
    cat > /etc/profile.d/zzz-agent-path.sh << 'PATHEOF'
export PATH="/home/agent/.local/bin:/home/agent/.claude/local:/home/agent/superpowers/quokka/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PIP_BREAK_SYSTEM_PACKAGES=1
PATHEOF
    chmod 644 /etc/profile.d/zzz-agent-path.sh

%environment
    export TARGETARCH="linux/amd64"
    export PATH="/home/agent/.local/bin:/home/agent/.claude/local:/home/agent/superpowers/quokka/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    export PIP_BREAK_SYSTEM_PACKAGES=1

%runscript
    exec /bin/bash "$@"
